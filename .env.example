# Demo never calls Aligo. Set live only when preparing actual operation.
APP_MODE=demo
# Academy name must exactly match the approved template.
ACADEMY_NAME=
# Empty: generate a persistent secret on this computer.
FLASK_SECRET_KEY=
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=
ALIGO_SENDER_KEY=
ALIGO_TEMPLATE_CODE_NONE=
ALIGO_TEMPLATE_CODE_WEEKLY=
ALIGO_TEMPLATE_CODE_MONTHLY=
# Own phone number for template receipt checks.
ALIGO_TEST_PHONE=
# Y: API test / N: actual send. APP_MODE must also be live.
ALIGO_TEST_MODE=Y
# Example unit price; replace with your account price (VAT excluded).
ALIMTALK_UNIT_PRICE=6.5
